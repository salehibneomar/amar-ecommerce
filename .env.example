# === Application ===
# local | production. APP_DEBUG must be false on a live site
APP_NAME="AmarEcommerce"
APP_ENV=local
# Generated by: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8200
# true once the site holds real data: schema changes then go in new migrations only (AGENTS.md rule 9)
APP_IS_LIVE=false
# Development only, for AI coding agents (the app never reads it). free (default) = lean mode, core rules and fewest tool calls. paid = full AGENTS.md workflow
DEV_AI_AGENT=free
# Development only: true = AI agents skip updating project docs (TECHNICAL, DIAGRAM, HOW_TO, SETUP, SETUP_COMMANDS, OUR_RAG, INCOMPLETE) and only update AGENTS.md, CLAUDE.md, .ai/** and README.md. Default false
DEV_SKIP_OPTIONAL_DOCS=false
# Dev server address. 127.0.0.1 = this machine only. 0.0.0.0 = reachable on your LAN (dev only, never live)
SERVER_HOST=127.0.0.1
# Port used by composer dev / php artisan serve
SERVER_PORT=8200
# Vite on the LAN: set this to this machine's LAN IP (hostname -I) so other devices load assets and hot reload
# VITE_DEV_HOST=192.168.0.10
# PHP_CLI_SERVER_WORKERS=4
# URL prefix of the admin area (login, dashboard, manage, settings). Use a hard-to-guess value live, then run php artisan optimize
ADMIN_ROUTE_PREFIX=admin

# === Owner and credits (shown in the footer and admin) ===
APP_OWNER="AmarEcommerce"
# Edition badge shown next to the logo (empty hides it)
APP_EDITION=Lite
APP_DEVELOPER="Saleh Ibne Omar"
# Informational only, not read by the app
APP_VERSION=1.0.0

# === Region, language and formats ===
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# Currency code (invoices) and symbol (screens, emails). Money is always whole units
APP_CURRENCY=BDT
APP_CURRENCY_SYMBOL=৳
# Shown in admin tables and detail views when a field has no value
APP_EMPTY_VALUE=N/A
# Exact digits of a profile phone number (01XXXXXXXXX = 11)
VALID_PHONE_LENGTH=11

# === Interface ===
# Wait after the last keystroke before any search box searches (whole app), in ms
APP_SEARCH_DEBOUNCE_MS=300
# How deep categories go: 1 = root only, 2 = root › sub (default), 3 = root › sub › sub-sub (max). Deeper categories are ignored after lowering it
APP_CATEGORY_LEVEL=2

# === Maintenance mode ===
# system = managed from admin Settings -> System (php artisan down/up use the same setting)
APP_MAINTENANCE_DRIVER=system
# APP_MAINTENANCE_STORE=database

# === SEO (search results and link previews) ===
# false on staging or test sites: every page asks search engines not to index it
SEO_INDEXING_ENABLED=true
# Default description (about 150 characters). Book pages use their own description
SEO_DESCRIPTION="Buy digital and printed books online in Bangladesh. Read free previews, pay with bKash or Nagad and start reading in your library."
# Default preview image when sharing a link, ideally 1200x630 JPG/PNG. A path inside public/ (e.g. SEO_IMAGE=assets/logo/logo.png) or a full URL (e.g. SEO_IMAGE=https://your-domain.com/assets/logo/logo.png). Empty uses the logo set in Settings. Book pages use their cover
SEO_IMAGE=

# === Shop ===
# Order ID prefix (AE-XXXXXX), highest extra discount staff may add (%), and who gets "new order" emails
SHOP_ORDER_PREFIX=AE
SHOP_MAX_EXTRA_DISCOUNT=50
SHOP_OWNER_EMAIL=owner@example.com
# Offers for the whole shop only: hides offer types and category offers (true | false)
OFFER_GLOBAL_ONLY=true

# === Customer contact channels (checkout and contact page) ===
SUPPORT_EMAIL=support@example.com
WHATSAPP_NUMBER=01704915210
WHATSAPP_COUNTRY_CODE=880
FACEBOOK_MESSENGER_URL=https://m.me/amarecommerce
FACEBOOK_PAGE_URL=https://facebook.com/amarecommerce
FACEBOOK_GROUP_URL=https://facebook.com/groups/amarecommerce

# === Payment ===
# Default manual method (bkash | nagad) and the numbers customers pay to
PAYMENT_DEFAULT_METHOD=bkash
PAYMENT_BKASH_NUMBER=
PAYMENT_NAGAD_NUMBER=

# === Books ===
# What the shop sells: digital, physical or both
BOOK_STOCK_TYPE=both
# Pages in the free preview, and the binaries of the preview engines (SETUP.md -> Book preview engines)
BOOK_PREVIEW_PAGES=5
GHOSTSCRIPT_BINARY=gs
NODE_BINARY=node

# === Upload limits (MB) ===
BOOK_FILE_MAX_SIZE_MB=100
BOOK_COVER_MAX_SIZE_MB=3
BANNER_IMAGE_MAX_SIZE_MB=5
CATEGORY_IMAGE_MAX_SIZE_MB=3
USER_AVATAR_MAX_SIZE_MB=2
# Livewire temporary uploads: disk and the largest single upload
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local
LIVEWIRE_TEMPORARY_FILE_UPLOAD_MAX_SIZE_MB=100

# === Social login ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

# === Accounts and security ===
BCRYPT_ROUNDS=12
# Minimum password length for every account. Live sites also require mixed case, numbers and symbols
PASSWORD_MIN_LENGTH=6
# Email verification and password reset: link lifetime (minutes) and wait before resending (seconds)
EMAIL_VERIFICATION_EXPIRE_MINUTES=15
EMAIL_VERIFICATION_RESEND_SECONDS=300
PASSWORD_RESET_EXPIRE_MINUTES=15
PASSWORD_RESET_RESEND_SECONDS=300
# Rate limits: attempts allowed per minute
THROTTLE_LOGIN_ATTEMPTS=5
THROTTLE_REGISTER_ATTEMPTS=2
THROTTLE_CHECKOUT_ATTEMPTS=5
THROTTLE_TRACK_ORDER_ATTEMPTS=10
THROTTLE_PASSWORD_RESET_ATTEMPTS=10
THROTTLE_PASSWORD_RESET_LINK_ATTEMPTS=10
THROTTLE_VERIFICATION_EMAIL_ATTEMPTS=10
THROTTLE_ASSISTANT_ATTEMPTS=10

# === Database ===
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=amar_ecom_lite
DB_USERNAME=admin
DB_PASSWORD=root
# Demo data in seeders. Must be false on a live site
DB_SEEDING_ENABLED=true
# Super admin created when demo seeding is off. Remove the password after the first seed
DB_SEED_ADMIN_EMAIL=admin@example.com
DB_SEED_ADMIN_PASSWORD=123456

# === Sessions ===
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true on a live HTTPS site: the login cookie is never sent over plain http
SESSION_SECURE_COOKIE=false

# === Cache ===
CACHE_STORE=database
# CACHE_PREFIX=
# Public page data: on/off (false = always read the database), store (empty = CACHE_STORE, e.g. redis) and lifetime. Admin changes clear it at once
FRONTEND_CACHE_ENABLED=true
FRONTEND_CACHE_STORE=
FRONTEND_CACHE_TTL_MINUTES=180
# Only needed when a store above uses Redis or Memcached
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
MEMCACHED_HOST=127.0.0.1

# === Queue ===
# Nothing needs a worker unless MAIL_QUEUE_ENABLED=true. Book covers are resized during the upload
QUEUE_CONNECTION=database
QUEUE_CONVERSIONS_BY_DEFAULT=false

# === Mail ===
# failover = SMTP, or the log file when the mail server is down (the page never breaks)
MAIL_MAILER=failover
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Seconds to wait for the mail server
MAIL_TIMEOUT=10
# true = queue order emails and retry them while the mail server is down (needs a queue worker, see SETUP_COMMANDS.md)
MAIL_QUEUE_ENABLED=false
MAIL_QUEUE_BACKOFF_SECONDS=300
MAIL_QUEUE_RETRY_HOURS=24
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# === File storage ===
FILESYSTEM_DISK=local
# Only needed for the s3 disk
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# === Logging and broadcasting ===
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
BROADCAST_CONNECTION=log

# === AI shopping assistant (beta): the "Ask AI" page. Docs: OUR_RAG.md, wording: config/ai-prompts.php ===
# Show the page and its nav link. Also needs GEMINI_API_KEY and GEMINI_MODEL below
AI_ASSISTANT_ENABLED=false
# AI provider from config/ai-assistant.php (providers.*)
AI_ASSISTANT_PROVIDER=gemini
# Example question cards on the empty chat, separated by | (empty hides them)
AI_ASSISTANT_EXAMPLE_PROMPTS_UI="Suggest a book on rice farming|Which books help with fish farming?|Do you sell printed books or only PDFs?"
# Earlier messages sent with each question, and the longest message a customer can type
AI_ASSISTANT_HISTORY_MESSAGES=12
AI_ASSISTANT_MESSAGE_MAX_LENGTH=500
# Seconds to wait for the provider before showing the fallback
AI_ASSISTANT_TIMEOUT_SECONDS=20
# Books sent to the AI per question, and the most it may suggest
AI_ASSISTANT_CANDIDATES=20
AI_ASSISTANT_RESULTS=5
# Reuse identical answers for this many minutes (0 = off), and cap the tokens of one reply
AI_ASSISTANT_CACHE_MINUTES=60
AI_ASSISTANT_MAX_OUTPUT_TOKENS=1024
# Gemini: endpoint, key (https://aistudio.google.com), chat model and embedding model
# Empty GEMINI_EMBEDDING_MODEL = keyword search only. After changing it or the dimensions run: php artisan ai-assistant:embed
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
# Empty = the model default. For a thinking model (e.g. gemini-flash-latest) set 0 to stop billed "thinking" tokens
GEMINI_THINKING_BUDGET=

# === Frontend build (Vite) ===
VITE_APP_NAME="${APP_NAME}"
