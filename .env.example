# === App ===
APP_NAME="AmarEcommerce"
# local or production
APP_ENV=local
# Create with: php artisan key:generate
APP_KEY=
# Show error details. Always false on a live site
APP_DEBUG=true
APP_URL=http://localhost:8200
# Just a label for production. The app does not change because of it
APP_IS_IN_PRODUCTION=false
# Admin area URL prefix. Use a hard-to-guess value on a live site, then run php artisan optimize
ADMIN_ROUTE_PREFIX=admin

# === Development only (the app never reads these) ===
# true = AI agents may edit old migrations (rebuild with php artisan app:fresh --seed). false = new migrations only
DEV_CAN_MIGRATE_FRESH=false
# Dev server: 127.0.0.1 = this computer only, 0.0.0.0 = whole local network
SERVER_HOST=127.0.0.1
SERVER_PORT=8200
# Your LAN IP (hostname -I), so other devices on the network get assets and hot reload
# VITE_DEV_HOST=192.168.0.10
# PHP_CLI_SERVER_WORKERS=4

# === Owner and credits (footer and admin) ===
APP_OWNER="AmarEcommerce"
# Badge next to the logo (empty hides it)
APP_EDITION=Lite
APP_DEVELOPER="Saleh Ibne Omar"

# === Region and formats ===
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# Currency code (invoices) and symbol (screens and emails). Money is always whole units
APP_CURRENCY=BDT
APP_CURRENCY_SYMBOL=৳
# Shown in admin when a field is empty
APP_EMPTY_VALUE=N/A
# Exact digits in a phone number (01XXXXXXXXX = 11)
VALID_PHONE_LENGTH=11

# === Interface ===
# Wait after typing before a search box searches (ms)
APP_SEARCH_DEBOUNCE_MS=300
# Seconds between notification bell refreshes (300 = 5 minutes)
APP_NOTIFICATION_LONG_POLL_SECONDS=300
# Category depth: 1 = root only, 2 = root › sub, 3 = root › sub › sub-sub
APP_CATEGORY_LEVEL=2

# === Maintenance mode ===
# system = turn on and off in admin Settings › System (php artisan down/up too)
APP_MAINTENANCE_DRIVER=system
# APP_MAINTENANCE_STORE=database

# === SEO ===
# false on staging or test sites, so search engines skip them
SEO_INDEXING_ENABLED=true
# Default page description (about 150 characters)
SEO_DESCRIPTION="Shop quality products online at fair prices with home delivery and easy order tracking."
# Default link preview image (1200x630): a path in public/ or a full URL. Empty = the logo
SEO_IMAGE=
# Google Search Console HTML tag code (only the content value). Empty = no tag
SEO_GOOGLE_SITE_VERIFICATION=
# true shows the per-page "Hide From Search" switch on products and categories and applies it
SEO_PAGE_NOINDEX_ENABLED=false
# Max size of an uploaded link preview image, in MB
SEO_IMAGE_MAX_SIZE_MB=2

# === Shop ===
# Order ID prefix (AE-XXXXXX)
SHOP_ORDER_PREFIX=AE
# Highest extra discount staff can add (%)
SHOP_MAX_EXTRA_DISCOUNT=50
# Who gets "new order" emails
SHOP_OWNER_EMAIL=owner@example.com
# true = offers apply to the whole shop only (no offer types or category offers)
OFFER_GLOBAL_ONLY=true

# === Customer contact (checkout and contact page) ===
SUPPORT_EMAIL=support@example.com
WHATSAPP_NUMBER=01704915210
WHATSAPP_COUNTRY_CODE=880
FACEBOOK_MESSENGER_URL=https://m.me/amarecommerce
FACEBOOK_PAGE_URL=https://facebook.com/amarecommerce
FACEBOOK_GROUP_URL=https://facebook.com/groups/amarecommerce

# === Payment ===
# First install only: gateways turned on at checkout, in order (cod, manual, stripe, sslcommerz, bkash). Change them later in Settings > Payments
PAYMENT_GATEWAYS=cod
# First install only: manual payment bKash and Nagad numbers. Change them later in Settings > Payments
PAYMENT_BKASH_NUMBER=
PAYMENT_NAGAD_NUMBER=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# SSLCommerz store credentials. Keep SANDBOX=true until you switch to a live store
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_COUNTRY=Bangladesh
# bKash Tokenized Checkout credentials. Keep SANDBOX=true until you switch to live merchant credentials
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

# === Images and uploads ===
# Most images per product (the first is the thumbnail)
PRODUCT_IMAGE_MAX_FILES=5
# Largest file size in MB
PRODUCT_IMAGE_MAX_SIZE_MB=3
CATEGORY_IMAGE_MAX_SIZE_MB=3
BANNER_IMAGE_MAX_SIZE_MB=5
USER_AVATAR_MAX_SIZE_MB=2
# Livewire temporary uploads: disk and largest file in MB
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local
LIVEWIRE_TEMPORARY_FILE_UPLOAD_MAX_SIZE_MB=100

# === Social login ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

# === Accounts and security ===
BCRYPT_ROUNDS=12
# Shortest password. Live sites also need mixed case, numbers and symbols
PASSWORD_MIN_LENGTH=6
# Email links: minutes before they expire, and seconds before a resend
EMAIL_VERIFICATION_EXPIRE_MINUTES=15
EMAIL_VERIFICATION_RESEND_SECONDS=300
PASSWORD_RESET_EXPIRE_MINUTES=15
PASSWORD_RESET_RESEND_SECONDS=300
# Rate limits: tries per minute
THROTTLE_LOGIN_ATTEMPTS=5
THROTTLE_REGISTER_ATTEMPTS=2
THROTTLE_CHECKOUT_ATTEMPTS=5
THROTTLE_TRACK_ORDER_ATTEMPTS=10
THROTTLE_PASSWORD_RESET_ATTEMPTS=10
THROTTLE_PASSWORD_RESET_LINK_ATTEMPTS=10
THROTTLE_VERIFICATION_EMAIL_ATTEMPTS=10
THROTTLE_ASSISTANT_ATTEMPTS=10

# === Database ===
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=amar_ecom_lite
DB_USERNAME=admin
DB_PASSWORD=root
# Add demo data when seeding. Always false on a live site
DB_SEEDING_ENABLED=true
# Super admin made when demo data is off. Remove the password after the first seed
DB_SEED_ADMIN_EMAIL=admin@example.com
DB_SEED_ADMIN_PASSWORD=123456

# === Sessions ===
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true on a live HTTPS site
SESSION_SECURE_COOKIE=false

# === Cache ===
CACHE_STORE=database
# CACHE_PREFIX=
# Public page cache. Empty store = CACHE_STORE. Admin changes clear it right away
FRONTEND_CACHE_ENABLED=true
FRONTEND_CACHE_STORE=
FRONTEND_CACHE_TTL_MINUTES=180
# Only for Redis or Memcached
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
MEMCACHED_HOST=127.0.0.1

# === Queue ===
# A worker is only needed when MAIL_QUEUE_ENABLED=true
QUEUE_CONNECTION=database
QUEUE_CONVERSIONS_BY_DEFAULT=false

# === Mail ===
# failover = SMTP, or the log file when the mail server is down
MAIL_MAILER=failover
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Seconds to wait for the mail server
MAIL_TIMEOUT=10
# true = queue order emails and retry while the mail server is down (needs a worker)
MAIL_QUEUE_ENABLED=false
MAIL_QUEUE_BACKOFF_SECONDS=300
MAIL_QUEUE_RETRY_HOURS=24
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# === File storage ===
FILESYSTEM_DISK=local
# Where uploaded images go: public, assets or r2
MEDIA_DISK=public
# Only for MEDIA_DISK=r2 (Cloudflare R2)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_URL=
R2_ROOT=
# Only for the s3 disk
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# === Logging ===
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
BROADCAST_CONNECTION=log

# === AI shopping assistant (the "Ask AI" page). Docs: OUR_RAG.md ===
# Show the page. Also needs AI_CHAT_URL, AI_CHAT_API_KEY and AI_CHAT_MODEL
AI_ASSISTANT_ENABLED=false
# Example questions on the empty chat, split by | (empty hides them)
AI_ASSISTANT_EXAMPLE_PROMPTS_UI="Suggest a gift under 1000|What is new this week?|Which products are on sale?"
# Past messages sent with each question, and the longest message allowed
AI_ASSISTANT_HISTORY_MESSAGES=12
AI_ASSISTANT_MESSAGE_MAX_LENGTH=500
# Seconds to wait for the AI before showing keyword results
AI_ASSISTANT_TIMEOUT_SECONDS=20
# How many best-matching products are sent to the AI per question, and the most it can suggest
AI_ASSISTANT_TOP_MATCHES=5
AI_ASSISTANT_RESULTS=5
# Minutes to reuse the same answer (0 = off), and the most tokens per reply
AI_ASSISTANT_CACHE_MINUTES=60
AI_ASSISTANT_MAX_OUTPUT_TOKENS=1024
# Chat (the AI that answers). Driver: openai (Groq, OpenAI, Ollama and most others) or gemini
# Groq: openai, https://api.groq.com/openai/v1, openai/gpt-oss-120b (free key: console.groq.com)
# Gemini: gemini, https://generativelanguage.googleapis.com/v1beta/models, gemini-flash-lite-latest
AI_CHAT_DRIVER=openai
AI_CHAT_URL=https://api.groq.com/openai/v1
AI_CHAT_API_KEY=
AI_CHAT_MODEL=openai/gpt-oss-120b
# low, medium or high. For Gemini a number (0 = off). Empty = model default
AI_CHAT_REASONING=low
# Embeddings (meaning-based search). Empty driver, URL or key = the chat ones. Empty model = keyword search only
# Groq has none, so Gemini is used (free key: aistudio.google.com). After changing these run: php artisan ai-assistant:embed
AI_EMBEDDING_DRIVER=gemini
AI_EMBEDDING_URL=https://generativelanguage.googleapis.com/v1beta/models
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=768
